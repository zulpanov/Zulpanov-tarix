{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && auth.token.email === 'zulpanov@zulpanovtarix.uz'))"
      }
    },
    "c": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "grp": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "logins": {
      "$login": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.val() === auth.uid && (!$login.matches(/^(tg[0-9]+|bot)$/) || auth.token.email.beginsWith($login + '.'))))"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.exists() && newData.child('b').val() === data.child('b').val() && newData.child('rs/n').val() === data.child('rs/n').val() && newData.child('rs/s').val() === data.child('rs/s').val() && (newData.child('g').val() === data.child('g').val() || !newData.child('g').exists() || newData.child('g').val() === '' || (newData.child('gk').isString() && root.child('grpk').child(newData.child('gk').val()).val() === newData.child('g').val())) && (!data.exists() || newData.child('bx').val() === data.child('bx').val()) && (data.exists() || !newData.child('bx').exists() || newData.child('bx').val() === 50)))"
      }
    },
    "pw": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "r": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.exists()))"
      },
      ".indexOn": [
        "at"
      ]
    },
    "h": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "mx": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "lb": {
      "$week": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !$week.matches(/^w[0-9]{8}$/)))"
        }
      }
    },
    "cq": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "hw": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "hwr": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$hw": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "a": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "t": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "players": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid"
          }
        }
      }
    },
    "tg": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "u": {
        ".indexOn": [
          "login"
        ]
      }
    },
    "grpk": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$k": {
        ".read": true
      }
    },
    "st": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$day": {
        "$k": {
          ".write": "$day.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && $k.matches(/^[a-z0-9_]{1,12}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "kt": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        },
        "j": {
          ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.hasChild('n')"
          }
        },
        "r": {
          ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "rk": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },
        "res": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        }
      }
    }
  }
}